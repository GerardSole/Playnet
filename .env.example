# ─────────────────────────────────────────────────────────────────────────────
# Playnet — environment variables
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# For local development:  DATABASE_URL and REDIS_URL use localhost
# For Docker Compose:     docker-compose.yml overrides DATABASE_URL and
#                         REDIS_URL to use the internal service hostnames.
#                         Only JWT_SECRET is read from .env at compose-up time.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@localhost:5432/playnet

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED — must be at least 32 characters. Change before any real deployment.
JWT_SECRET=change-this-secret-in-production-min-32-chars
JWT_ISSUER=playnet
JWT_AUDIENCE=playnet-api
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
