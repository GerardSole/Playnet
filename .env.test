NODE_ENV=test
PORT=3001
HOST=0.0.0.0

# Isolated test database — never the dev DB
DATABASE_URL=postgresql://postgres:password@localhost:5432/playnet_test

# Redis DB index 1 — isolated from dev (DB 0)
REDIS_URL=redis://localhost:6379/1

JWT_SECRET=test-secret-for-integration-tests-only!
JWT_ISSUER=playnet
JWT_AUDIENCE=playnet-api
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# High limits so tests never hit rate limiting
RATE_LIMIT_MAX=100000
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10000

# Small enough to test eviction without too many logins, large enough that
# the existing auth tests (which create at most 3 sessions per user) are unaffected.
MAX_SESSIONS_PER_USER=5

# Cleanup job — effectively disabled during tests so the background timer does
# not interfere.  Tests invoke the cleanup helper directly when needed.
TOKEN_CLEANUP_INTERVAL_MS=999999999
TOKEN_CLEANUP_BATCH_SIZE=100
